# Copiare in .env.local e valorizzare. .env.local non e versionato.

NEXT_PUBLIC_SANITY_PROJECT_ID=xpdypayk

# I contenuti reali vivono qui, ed e il dataset che serve il sito pubblicato.
# Lo Studio in locale scrive nello stesso Content Lake: non e una copia di prova.
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-07
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token con permesso Viewer, da sanity.io/manage -> API -> Tokens.
# Serve dalla Fase 2 per leggere le bozze in anteprima.
SANITY_API_READ_TOKEN=

# Segreti server-side, generati a caso. Servono dalla Fase 2 e dalla Fase 3.
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=

# Token con permesso Editor. Serve SOLO agli script locali di seed.
# Non ha prefisso NEXT_PUBLIC_ e non deve mai finire nel bundle.
SANITY_WRITE_TOKEN=
